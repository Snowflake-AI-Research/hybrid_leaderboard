{
  "meta": {
    "benchmark": "HybridDeepResearch",
    "tagline": "Enforcing rigor across SQL and web search for enterprise agents",
    "description": "A rigorous benchmark for enterprise deep-research agents that must fuse structured evidence from a governed SQL database with unstructured information from web search. Every task is built so that neither side alone can solve it. Systems are scored overall and across three cross-modal task families.",
    "isSampleData": false,
    "news": [
      {
        "date": "2026-08-31",
        "title": "Code and dataset now available",
        "body": "We've released the HybridDeepResearch code and dataset. Get the example code on GitHub and the tasks on Hugging Face.",
        "links": [
          { "label": "Code", "url": "https://github.com/snowflake-eng/HybridDeepResearch/tree/main" },
          { "label": "Dataset", "url": "https://huggingface.co/datasets/Snowflake/HybridDeepResearch" }
        ]
      },
      {
        "date": "2026-06-02",
        "title": "HybridDeepResearch benchmark released",
        "body": "The first benchmark for enterprise hybrid deep research, combining SQL and web search, is now public.",
        "link": "https://www.snowflake.com/en/blog/engineering/hybrid-deep-research-benchmark/"
      }
    ]
  },
